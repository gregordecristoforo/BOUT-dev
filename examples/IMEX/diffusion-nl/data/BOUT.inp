
alpha = 2.5  # Diffusion exponent: D = f ^ alpha

MXG = 0

[mesh]

nx = 1
nz = 1
ny = 64

length = 10
dy = length / ny

ixseps1 = ny
ixseps2 = ny

[f]

scale = 1
function = 1 + 0.5*sin(y)

[solver]
output_step = 1
cvode_precon_method = user  # Call the preconditioner (precon)

nout = 10

[pardiv]
type = fci  # InvertParDiv backend used in the preconditioner
